[Unit]
Description=NVR person detection (decoupled post-hoc consumer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nvr
Environment=NVR_DATA=/home/ubuntu/nvr-data
Environment=NVR_DET_CONF=0.25
# Sampling budget on this 2-core / 952 MB box. History:
#   STRIDE=1/FRAMES=2 (2 frames/segment, ~0.2 fps, 4x) overloaded it with NO swap: the mid-segment
#   decode competes with the recorder's ffmpeg and the box thrashed (loadavg ~25, API hung).
#   STRIDE=1/FRAMES=1 (the "gentle 2x" step after the 2026-11-21 swapfile) was tried and backed out:
#   when the camera uplink later collapsed, recording needed all the headroom, so detection yields it.
# STRIDE=2 = ~1 frame every 2 segments (~0.05 fps) leaves the recorder's ffmpeg uncontended. This is
# the sustained setting; revisit a bump only once the uplink is healthy. decode_frames() dormant at FRAMES=1.
Environment=DET_STRIDE=2
ExecStart=/home/ubuntu/nvr/venv-detect/bin/python /home/ubuntu/nvr/detect_service.py run
Restart=always
RestartSec=10
# resource guardrails: detection can NEVER starve the recorder on this 1GB box.
Nice=15
CPUWeight=20
IOWeight=20
MemoryHigh=380M
MemoryMax=460M

[Install]
WantedBy=multi-user.target
