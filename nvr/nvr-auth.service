[Unit]
Description=NVR sign-in: Firebase Google sign-in -> session cookie for nginx (auth_gate.js)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/nvr
Environment=AUTH_DIR=/home/ubuntu/auth
ExecStart=/usr/bin/node /home/ubuntu/nvr/auth_gate.js
Restart=always
RestartSec=5
MemoryMax=80M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/auth

[Install]
WantedBy=multi-user.target
