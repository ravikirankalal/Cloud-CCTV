[Unit]
Description=Put live HD clips at their picture's own time (camera clock read off the picture)
After=hd-record.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/rtmp-web
ExecStart=/home/ubuntu/rtmp-web/.venv/bin/python /home/ubuntu/rtmp-web/hd_retime.py cam1
TimeoutStartSec=2h
Nice=15
CPUQuota=60%
MemoryMax=400M
