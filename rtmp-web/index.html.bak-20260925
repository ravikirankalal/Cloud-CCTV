<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0c0f13" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>Stream Recordings</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='9' fill='%23ff4d5e'/%3E%3C/svg%3E">
<style>
:root{
  --bg:#0c0f13; --panel:#14181f; --panel-2:#1a2029; --line:#252d38; --line-2:#323c4a;
  --text:#e8edf3; --muted:#8b97a7; --faint:#5d6978;
  --accent:#4d8dff; --accent-soft:rgba(77,141,255,.16);
  --live:#ff4d5e; --warn:#f2b33d;
  --radius:14px; --shadow:0 18px 50px rgba(0,0,0,.45);
  color-scheme:dark;
}
@media (prefers-color-scheme: light){
  :root{
    --bg:#f4f6f9; --panel:#ffffff; --panel-2:#eef1f5; --line:#e0e5ec; --line-2:#cfd6e0;
    --text:#131922; --muted:#5b6777; --faint:#8c97a5;
    --accent:#2f6fe8; --accent-soft:rgba(47,111,232,.12);
    --shadow:0 18px 50px rgba(20,30,50,.18);
    color-scheme:light;
  }
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--text);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
button:disabled{cursor:default}
a{color:inherit}
svg{display:block}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}

/* ---------- top bar ---------- */
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:14px;padding:12px 24px;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;font-weight:650;font-size:16px;letter-spacing:-.01em}
.brand .dot{width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,var(--live),#ff8a4d);display:grid;place-items:center;color:#fff}
.live-pill{display:none;align-items:center;white-space:nowrap;max-width:45vw;overflow:hidden;text-overflow:ellipsis;gap:7px;padding:4px 10px 4px 8px;border-radius:999px;background:rgba(255,77,94,.14);color:var(--live);font-weight:600;font-size:12px}
.live-pill.on{display:inline-flex}
.pulse{width:8px;height:8px;border-radius:50%;background:var(--live);animation:pulse 1.4s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,77,94,.6)}70%{box-shadow:0 0 0 7px rgba(255,77,94,0)}100%{box-shadow:0 0 0 0 rgba(255,77,94,0)}}
.spacer{flex:1}
.updated{color:var(--faint);font-size:12px}
.icon-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--line);background:var(--panel);font-size:13px}
.icon-btn:hover:not(:disabled){border-color:var(--line-2);background:var(--panel-2)}
.icon-btn:disabled{opacity:.4}
.spin svg{animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- layout ---------- */
.wrap{max-width:1440px;margin:0 auto;padding:20px 24px 60px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px}
.stat .k{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.06em}
.stat .v{font-size:22px;font-weight:650;margin-top:4px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .s{color:var(--faint);font-size:12px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:20px;align-items:start}
main,aside{min-width:0}
html,body{overflow-x:clip}
aside{position:sticky;top:78px;display:flex;flex-direction:column;gap:14px}
.box{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px}
.box h3{margin:0 0 10px;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:600}

/* calendar */
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.cal-head b{font-weight:600}
.cal-nav{display:flex;gap:4px}
.cal-nav button{width:28px;height:28px;border-radius:7px;display:grid;place-items:center;color:var(--muted)}
.cal-nav button:hover{background:var(--panel-2);color:var(--text)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}
.cal-grid .wd{font-size:11px;color:var(--faint);padding:2px 0 4px}
.cd{position:relative;aspect-ratio:1;border-radius:8px;font-size:12.5px;font-variant-numeric:tabular-nums;color:var(--faint)}
.cd.l1,.cd.l2,.cd.l3{color:var(--text);font-weight:550}
.cd.l1{background:color-mix(in srgb,var(--accent) 16%,transparent)}
.cd.l2{background:color-mix(in srgb,var(--accent) 32%,transparent)}
.cd.l3{background:color-mix(in srgb,var(--accent) 52%,transparent)}
.cd:not(:disabled):hover{outline:1px solid var(--accent)}
.cd.today{box-shadow:inset 0 0 0 1.5px var(--line-2)}
.cd.sel{background:var(--accent);color:#fff}
.cd.has-live::after{content:"";position:absolute;top:3px;right:3px;width:5px;height:5px;border-radius:50%;background:var(--live)}
.cal-foot{display:flex;justify-content:space-between;align-items:center;margin-top:10px;font-size:12px;color:var(--faint)}
.link{color:var(--accent);font-size:12px}
.link:hover{text-decoration:underline}

/* streams */
.streams{display:flex;flex-direction:column;gap:2px}
.stream-btn{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:9px;text-align:left}
.stream-btn:hover{background:var(--panel-2)}
.stream-btn.on{background:var(--accent-soft);color:var(--accent)}
.stream-btn .sw{width:8px;height:8px;border-radius:3px;flex:none}
.stream-btn .n{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stream-btn .c{color:var(--faint);font-size:12px;font-variant-numeric:tabular-nums}
.stream-btn .lv{width:7px;height:7px;border-radius:50%;background:var(--live)}

/* toolbar */
.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:16px}
.search{flex:1;min-width:200px;position:relative}
.search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--faint)}
.search input{width:100%;height:38px;padding:0 12px 0 36px;border-radius:10px;border:1px solid var(--line);background:var(--panel);color:var(--text);font:inherit}
.search input:focus{outline:none;border-color:var(--accent)}
.seg-ctl{display:inline-flex;padding:3px;border-radius:10px;background:var(--panel);border:1px solid var(--line)}
.seg-ctl button{height:30px;padding:0 12px;border-radius:7px;color:var(--muted);font-size:13px}
.seg-ctl button.on{background:var(--panel-2);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.2)}
.chip{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 6px 0 12px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-size:13px;font-weight:550}
.chip button{width:20px;height:20px;border-radius:50%;display:grid;place-items:center}
.chip button:hover{background:color-mix(in srgb,var(--accent) 25%,transparent)}

.notice{padding:10px 14px;border-radius:10px;background:rgba(242,179,61,.12);color:var(--warn);font-size:13px;margin-bottom:14px}

/* day groups */
.day{margin-bottom:30px}
.day-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:10px}
.day-head h2{margin:0;font-size:18px;letter-spacing:-.01em}
.day-head .sub{color:var(--muted);font-size:13px}
.day-sum{color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums;white-space:nowrap}

.timeline{margin-bottom:14px}
.track{position:relative;height:30px;border-radius:9px;background:var(--panel);border:1px solid var(--line);
  background-image:repeating-linear-gradient(to right,var(--line) 0 1px,transparent 1px calc(100%/24));overflow:hidden}
.tl-seg{position:absolute;top:5px;bottom:5px;min-width:4px;border-radius:4px;background:var(--accent);opacity:.9;transition:transform .12s,opacity .12s}
.tl-seg:hover{opacity:1;transform:scaleY(1.2)}
.tl-seg.recording{background:var(--live);animation:blink 1.6s infinite}
.tl-seg.flv{background:var(--warn)}
@keyframes blink{50%{opacity:.55}}
.now-line{position:absolute;top:0;bottom:0;width:2px;background:var(--live);opacity:.7}
.ticks{position:relative;height:16px;margin-top:3px}
.ticks span{position:absolute;transform:translateX(-50%);font-size:10.5px;color:var(--faint);font-variant-numeric:tabular-nums}
.ticks span:first-child{transform:none}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.card{display:flex;flex-direction:column;text-align:left;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:transform .15s,border-color .15s,box-shadow .15s}
@media (hover:hover){.card:hover{transform:translateY(-2px);border-color:var(--line-2);box-shadow:var(--shadow)}}
.card:active{transform:scale(.985)}
.thumb{position:relative;aspect-ratio:16/9;background:var(--panel-2);overflow:hidden}
.thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.thumb .ph{position:absolute;inset:0;display:grid;place-items:center;color:var(--faint)}
.thumb .dur{position:absolute;right:8px;bottom:8px;padding:2px 7px;border-radius:6px;background:rgba(0,0,0,.72);color:#fff;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}
.thumb .badge{position:absolute;left:8px;top:8px;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:700;letter-spacing:.03em;color:#fff}
.badge.live{background:var(--live)}
.badge.warn{background:var(--warn);color:#1a1300}
.thumb .play{position:absolute;inset:0;display:grid;place-items:center;opacity:0;transition:opacity .15s;background:rgba(0,0,0,.25)}
.thumb .play i{width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.95);color:#111;display:grid;place-items:center}
@media (hover:hover){.card:hover .play{opacity:1}}
.card .body{padding:11px 13px 13px}
.card .title{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .when{color:var(--muted);font-size:13px;margin-top:1px;font-variant-numeric:tabular-nums}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
.tags span{font-size:11.5px;padding:2px 7px;border-radius:6px;background:var(--panel-2);color:var(--muted);font-variant-numeric:tabular-nums}

.empty{padding:70px 20px;text-align:center;color:var(--muted);background:var(--panel);border:1px dashed var(--line-2);border-radius:var(--radius)}
.empty b{display:block;color:var(--text);font-size:16px;margin-bottom:4px}
.skeleton{height:220px;border-radius:var(--radius);background:linear-gradient(90deg,var(--panel) 0%,var(--panel-2) 50%,var(--panel) 100%);background-size:200% 100%;animation:sh 1.3s infinite}
@keyframes sh{to{background-position:-200% 0}}

/* ---------- player modal ---------- */
.modal{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(5,7,10,.78);backdrop-filter:blur(6px)}
.modal.open{display:flex}
.mcard{width:min(1280px,100%);max-height:100%;display:grid;grid-template-columns:minmax(0,1fr) 330px;background:var(--panel);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:var(--shadow)}
.stage{background:#000;display:flex;align-items:center;justify-content:center;min-height:300px}
.stage video{width:100%;max-height:calc(100vh - 48px);aspect-ratio:16/9;background:#000;display:block}
.nope{padding:40px;text-align:center;color:#c9d1db;max-width:420px}
.nope b{display:block;color:#fff;font-size:17px;margin-bottom:6px}
.side{display:flex;flex-direction:column;min-height:0;overflow:auto}
.side-head{display:flex;align-items:flex-start;gap:10px;padding:18px 18px 12px;border-bottom:1px solid var(--line);order:-2}
.side-head h3{margin:0;font-size:17px;word-break:break-word}
.side-head .sub{color:var(--muted);font-size:13px;margin-top:2px}
.side-head .icon-btn{flex:none;width:34px;padding:0}
dl.meta{display:grid;grid-template-columns:auto 1fr;gap:9px 14px;margin:0;padding:16px 18px;font-size:13px}
dl.meta dt{color:var(--muted)}
dl.meta dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;word-break:break-all}
.side-sec{padding:0 18px 16px}
.side-sec .lbl{font-size:12px;color:var(--muted);margin-bottom:6px}
.speeds{display:flex;gap:4px;flex-wrap:wrap}
.speeds button{height:28px;padding:0 10px;border-radius:7px;border:1px solid var(--line);font-size:12.5px;font-variant-numeric:tabular-nums}
.speeds button.on{background:var(--accent);border-color:var(--accent);color:#fff}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 18px 16px}
.actions a,.actions button{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:38px;border-radius:10px;border:1px solid var(--line);background:var(--panel-2);text-decoration:none;font-size:13px;font-weight:550}
.actions a.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.actions a:hover,.actions button:hover{filter:brightness(1.08)}
.pn{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 18px 18px;margin-top:auto}
.pn .icon-btn{height:38px}
.kbd{color:var(--faint);font-size:11.5px;padding:0 18px 16px}
.kbd kbd{font:inherit;padding:1px 5px;border-radius:4px;border:1px solid var(--line-2);color:var(--muted)}

.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;z-index:60;padding:10px 16px;border-radius:10px;background:var(--text);color:var(--bg);font-size:13px;font-weight:550;transition:.2s;pointer-events:none}
.toast.on{opacity:1;transform:translate(-50%,0)}

/* ---------- responsive ---------- */
@media (max-width:1000px){
  .layout{grid-template-columns:minmax(0,1fr)}
  aside{position:static;display:grid;grid-template-columns:1fr 1fr}
  .mcard{grid-template-columns:1fr;overflow:auto}
  .stage video{max-height:60vh}
}
@media (max-width:640px){
  .top{padding:10px 16px}
  .wrap{padding:16px 16px 40px}
  .updated{display:none}
  .brand{font-size:15px}
  #refresh span{display:none}
  .stats{grid-template-columns:1fr 1fr}
  aside{grid-template-columns:1fr}
  .ticks .minor{display:none}
  .modal{padding:0}
  .mcard{border-radius:0;height:100%;border:0}
  .day-head{flex-direction:column;align-items:flex-start;gap:2px}
}

/* ---------- mobile ---------- */
.tb-row{display:flex;align-items:center;gap:10px}
.m-only{display:none !important}
.m-streams{gap:6px;overflow-x:auto;margin:0 -16px 14px;padding:2px 16px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.m-streams::-webkit-scrollbar,.tb-row::-webkit-scrollbar,.stats::-webkit-scrollbar{display:none}
.m-streams button{flex:none;display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 13px;border-radius:999px;border:1px solid var(--line);background:var(--panel);font-size:13px;white-space:nowrap}
.m-streams button .sw{width:8px;height:8px;border-radius:3px}
.m-streams button .c{color:var(--faint);font-size:12px}
.m-streams button.on{background:var(--accent);border-color:var(--accent);color:#fff}
.m-streams button.on .c{color:rgba(255,255,255,.8)}
.m-streams button .lv{width:7px;height:7px;border-radius:50%;background:var(--live)}

@media (max-width:640px){
  body{font-size:14.5px}
  .m-only{display:flex !important}
  .top{padding:10px 16px;padding-top:max(10px,env(safe-area-inset-top))}
  .wrap{padding:14px 16px calc(40px + env(safe-area-inset-bottom))}

  /* stats: swipeable row */
  .stats{display:flex;overflow-x:auto;gap:10px;margin:0 -16px 16px;padding:0 16px;scroll-snap-type:x mandatory;scroll-padding-inline:16px;scrollbar-width:none}
  .stat{flex:0 0 44%;scroll-snap-align:start;padding:11px 13px}
  .stat .k{font-size:11px}
  .stat .v{font-size:19px}

  /* sidebar -> calendar drawer, streams -> chip row */
  aside{display:none;position:static;margin-bottom:14px}
  body.cal-open aside{display:block}
  aside .box + .box{display:none}
  .cd{font-size:14px;aspect-ratio:auto;height:40px}

  /* toolbar */
  .toolbar{gap:8px;margin-bottom:10px}
  .search{flex:1 1 100%;min-width:0}
  .search input{height:44px;font-size:16px;border-radius:12px}
  .tb-row{flex:1 1 100%;overflow-x:auto;margin:0 -16px;padding:2px 16px;scrollbar-width:none}
  .tb-row > *{flex:none}
  .tb-row .icon-btn{height:38px;border-radius:10px}
  body.cal-open #calToggle{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
  .seg-ctl button{height:32px;padding:0 12px}
  #dayChip:empty{display:none}

  /* day groups */
  .day{margin-bottom:24px}
  .day-head h2{font-size:17px}
  .track{height:34px}
  .tl-seg{min-width:8px}

  /* cards -> compact list rows */
  .grid{grid-template-columns:1fr;gap:10px}
  .card{flex-direction:row;align-items:stretch;border-radius:12px}
  .thumb{width:38%;max-width:170px;flex:none;aspect-ratio:16/10}
  .thumb .dur{right:5px;bottom:5px;font-size:11px;padding:1px 6px}
  .thumb .badge{left:5px;top:5px;font-size:10px;padding:2px 6px}
  .thumb .ph svg{width:26px;height:26px}
  .card .body{flex:1;min-width:0;padding:9px 11px;display:flex;flex-direction:column;justify-content:center}
  .card .when{font-size:12.5px}
  .tags{margin-top:6px}
  .tags span{font-size:11px;padding:1px 6px}

  /* player: full screen, video pinned on top, details scroll */
  .modal{padding:0;background:var(--bg);backdrop-filter:none}
  .mcard{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);width:100%;height:100vh;height:100dvh;max-height:none;border-radius:0;border:0;box-shadow:none;overflow:hidden}
  .stage{min-height:0;padding-top:env(safe-area-inset-top);background:#000}
  .stage video{max-height:none;width:100%;aspect-ratio:16/9}
  .nope{padding:28px 20px}
  .side{overflow-y:auto;-webkit-overflow-scrolling:touch;padding-bottom:env(safe-area-inset-bottom)}
  .side-head{padding:14px 16px 10px;position:sticky;top:0;background:var(--panel);z-index:1}
  .side-head .icon-btn{width:40px;height:40px;border-radius:50%}
  dl.meta{padding:12px 16px;gap:8px 12px}
  .side-sec{padding:0 16px 14px}
  .speeds button{height:34px;padding:0 12px;flex:1}
  .actions{padding:0 16px 12px}
  .actions a,.actions button{height:44px}
  .pn{order:-1;padding:12px 16px 4px;margin-top:0}
  .pn .icon-btn{height:44px}
  .kbd{display:none}
}
@media (hover:none){ .kbd{display:none} }
</style>
</head>
<body>

<header class="top">
  <div class="brand"><span class="dot"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg></span>Recordings</div>
  <span class="live-pill" id="livePill" role="button" tabindex="0" title="Watch live" style="cursor:pointer"><span class="pulse"></span><span id="liveText">LIVE</span></span>
  <div class="spacer"></div>
  <span class="updated" id="updated"></span>
  <button class="icon-btn" id="refresh" title="Refresh">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
    <span>Refresh</span>
  </button>
</header>

<div class="wrap">
  <section class="stats" id="stats"></section>

  <div class="layout">
    <aside>
      <div class="box">
        <div class="cal-head">
          <b id="calTitle"></b>
          <div class="cal-nav">
            <button id="calPrev" aria-label="Previous month"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg></button>
            <button id="calNext" aria-label="Next month"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></button>
          </div>
        </div>
        <div class="cal-grid" id="calGrid"></div>
        <div class="cal-foot"><span id="calInfo"></span><button class="link" id="calToday">Today</button></div>
      </div>
      <div class="box">
        <h3>Streams</h3>
        <div class="streams" id="streams"></div>
      </div>
    </aside>

    <main>
      <div class="toolbar">
        <label class="search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="q" type="search" placeholder="Search streams, files, dates…" autocomplete="off">
        </label>
        <div class="tb-row">
        <button class="icon-btn m-only" id="calToggle" aria-expanded="false">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          <span>Calendar</span>
        </button>
        <div class="seg-ctl" id="range">
          <button data-v="all" class="on">All</button>
          <button data-v="today">Today</button>
          <button data-v="7">7 days</button>
          <button data-v="30">30 days</button>
        </div>
        <div class="seg-ctl" id="sort">
          <button data-v="desc" class="on" title="Newest first">Newest</button>
          <button data-v="asc" title="Oldest first">Oldest</button>
        </div>
        </div>
        <span id="dayChip"></span>
      </div>
      <div class="m-streams m-only" id="mStreams"></div>
      <div id="notice"></div>
      <div id="groups"><div class="skeleton"></div></div>
    </main>
  </div>
</div>

<div class="modal" id="modal" aria-hidden="true">
  <div class="mcard" role="dialog" aria-modal="true" aria-labelledby="pTitle">
    <div class="stage">
      <video id="video" controls playsinline preload="metadata"></video>
      <div class="nope" id="nope" hidden></div>
    </div>
    <div class="side">
      <div class="side-head">
        <div style="flex:1;min-width:0">
          <h3 id="pTitle"></h3>
          <div class="sub" id="pSub"></div>
        </div>
        <button class="icon-btn" id="pClose" aria-label="Close"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
      </div>
      <dl class="meta" id="pMeta"></dl>
      <div class="side-sec" id="speedSec">
        <div class="lbl">Playback speed</div>
        <div class="speeds" id="speeds"></div>
      </div>
      <div class="actions">
        <a class="primary" id="pDownload" download>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>Download</a>
        <button id="pCopy">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>Copy link</button>
      </div>
      <div class="pn">
        <button class="icon-btn" id="pPrev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>Previous</button>
        <button class="icon-btn" id="pNext">Next<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
      <div class="kbd"><kbd>Space</kbd> play/pause · <kbd>←</kbd><kbd>→</kbd> seek 10s · <kbd>P</kbd>/<kbd>N</kbd> prev/next · <kbd>F</kbd> fullscreen · <kbd>Esc</kbd> close</div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ===== configuration ===== */
const CFG = {
  index:    '/recordings/index.json', // written by recordings.py
  fallback: '/api/files/',            // nginx autoindex JSON (used if index.json is missing)
  base:     '/recordings/',           // where the video files are served
  refreshMs: 60000,
  hls:      '/hls/',                  // live HLS playlists: /hls/<stream>.m3u8
  stat:     '/stat',                  // nginx-rtmp stats (who is live right now)
  statMs:   15000,
  hlsJs:    ['/assets/hls.min.js', 'https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js'],
};

/* ===== helpers ===== */
const $ = (s, el = document) => el.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad = n => String(n).padStart(2, '0');
const dayKey = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const fromKey = k => { const [y, m, d] = k.split('-').map(Number); return new Date(y, m - 1, d); };
const encPath = p => p.split('/').map(encodeURIComponent).join('/');
const fileUrl = f => CFG.base + encPath(f);

function fmtDur(s) {
  if (!s) return '—';
  s = Math.round(s);
  const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), sec = s % 60;
  return h ? `${h}h ${pad(m)}m` : m ? `${m}m ${pad(sec)}s` : `${sec}s`;
}
function fmtClock(s) {
  if (!s) return '—';
  s = Math.round(s);
  const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), sec = s % 60;
  return h ? `${h}:${pad(m)}:${pad(sec)}` : `${m}:${pad(sec)}`;
}
function fmtSize(b) {
  if (!b) return '—';
  const u = ['B', 'KB', 'MB', 'GB', 'TB']; let i = 0;
  while (b >= 1024 && i < u.length - 1) { b /= 1024; i++; }
  return `${b.toFixed(b >= 100 || i === 0 ? 0 : 1)} ${u[i]}`;
}
const fmtTime = d => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
const fmtTimeS = d => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
const fmtDateLong = d => d.toLocaleDateString([], { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const fmtDateShort = d => d.toLocaleDateString([], { day: 'numeric', month: 'short', year: 'numeric' });
function relDay(d) {
  const t = new Date(); t.setHours(0, 0, 0, 0);
  const diff = Math.round((t - d) / 864e5);
  if (diff === 0) return 'Today';
  if (diff === 1) return 'Yesterday';
  if (diff > 1 && diff < 7) return d.toLocaleDateString([], { weekday: 'long' });
  return d.toLocaleDateString([], { day: 'numeric', month: 'long' });
}
function ago(d) {
  const s = (Date.now() - d) / 1000;
  if (s < 60) return 'just now';
  if (s < 3600) return `${Math.floor(s / 60)} min ago`;
  if (s < 86400) return `${Math.floor(s / 3600)} h ago`;
  const days = Math.floor(s / 86400);
  return days === 1 ? 'yesterday' : `${days} days ago`;
}
function resLabel(r) {
  const h = r.height; if (!h) return '';
  return h >= 2160 ? '4K' : h >= 1440 ? '1440p' : h >= 1080 ? '1080p' : h >= 720 ? '720p' : h >= 480 ? '480p' : `${h}p`;
}
const PALETTE = ['#4d8dff', '#35c28b', '#b57bff', '#ff8a4d', '#2ec5d3', '#f2b33d', '#ff6fa8', '#8fa0ff'];
const colorMap = new Map();
const streamColor = s => { if (!colorMap.has(s)) colorMap.set(s, PALETTE[colorMap.size % PALETTE.length]); return colorMap.get(s); };

const NAME_RE = /^(.+?)(?:-(\d{9,11}))?_(\d{4})-(\d{2})-(\d{2})_(\d{2})-(\d{2})-(\d{2})$/;
function parseName(file) {
  const stem = file.replace(/\.[^.]+$/, '');
  const m = stem.match(NAME_RE);
  if (!m) return { stream: stem, start: null };
  const start = m[2] ? +m[2] : Date.UTC(+m[3], m[4] - 1, +m[5], +m[6], +m[7], +m[8]) / 1000;
  return { stream: m[1], start };
}

const ICON = {
  play: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>',
  film: '<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9.5v5l4-2.5z" fill="currentColor"/></svg>',
  close: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>',
};

/* ===== state ===== */
let RAW = [], ALL = [], visible = [], source = 'index', loadedOnce = false;
let LIVE = null; // Map(stream -> {ms}) from /stat, or null if /stat is unreachable
const state = { q: '', stream: '', range: 'all', day: null, sort: 'desc', month: null };
let currentFile = null, speed = 1;

/* ===== data ===== */
function norm(r) {
  const dur = +r.duration || 0;
  const startD = new Date(r.start * 1000);
  const status = r.status || 'ready';
  return { ...r, status, dur, startD, endD: new Date((r.start + dur) * 1000), day: dayKey(startD),
           playable: (status === 'ready' && /\.mp4$/i.test(r.file)) || status === 'recording' };
}

async function fetchStat() {
  try {
    const r = await fetch(`${CFG.stat}?t=${Date.now()}`, { cache: 'no-store' });
    if (!r.ok) throw 0;
    const x = new DOMParser().parseFromString(await r.text(), 'text/xml');
    const kid = (el, tag) => [...el.children].find(c => c.tagName === tag);
    const m = new Map();
    for (const st of x.getElementsByTagName('stream')) {
      const name = kid(st, 'name')?.textContent;
      if (name && st.getElementsByTagName('publishing').length) m.set(name, { ms: +(kid(st, 'time')?.textContent || 0) });
    }
    LIVE = m;
  } catch { LIVE = null; }
}

// merge recordings index with the real-time live list
function build() {
  const now = Date.now() / 1000;
  const STUB = 64 * 1024; // empty .flv files nginx creates on (re)connect
  let list = RAW.map(r => ({ ...r }));
  const unfinished = list.filter(r => r.status === 'recording');

  // one live entry per stream: pick the file that best matches the real session
  const liveNames = LIVE ? [...LIVE.keys()] : [...new Set(unfinished.map(r => r.stream))];
  const keep = new Set();
  for (const name of liveNames) {
    const cands = unfinished.filter(r => r.stream === name);
    const statStart = LIVE ? now - LIVE.get(name).ms / 1000 : null;
    let best = null;
    if (statStart !== null) {
      best = cands.reduce((b, r) => !b || Math.abs(r.start - statStart) < Math.abs(b.start - statStart) ? r : b, null);
      if (best && Math.abs(best.start - statStart) > 120) best = null; // file belongs to an older session
    } else {
      best = cands.filter(r => (r.size || 0) >= STUB).sort((a, b) => b.start - a.start)[0] || null;
    }
    if (!best) list.push(best = { file: 'live:' + name, stream: name, size: 0, status: 'recording', start: Math.round(statStart ?? now) });
    keep.add(best);
  }
  list = list.filter(r => {
    if (r.status !== 'recording' || keep.has(r)) return true;
    if ((r.size || 0) < STUB) return false;   // hide empty stub files
    r.status = 'processing';                   // earlier session, waiting for conversion
    return true;
  });
  for (const r of list) if (r.status === 'recording') r.duration = now - r.start;
  ALL = list.map(norm).sort((a, b) => b.start - a.start);
  ALL.forEach(r => streamColor(r.stream));
}

async function load() {
  const btn = $('#refresh'); btn.classList.add('spin'); btn.disabled = true;
  try {
    let recs;
    try {
      const r = await fetch(`${CFG.index}?t=${Date.now()}`, { cache: 'no-store' });
      if (!r.ok) throw new Error(r.status);
      recs = (await r.json()).recordings || [];
      source = 'index';
    } catch {
      const r = await fetch(CFG.fallback, { cache: 'no-store' });
      if (!r.ok) throw new Error(`Could not load recordings (HTTP ${r.status})`);
      const now = Date.now() / 1000;
      recs = (await r.json())
        .filter(f => f.type === 'file' && /\.(mp4|flv)$/i.test(f.name))
        .map(f => {
          const p = parseName(f.name), mt = Date.parse(f.mtime) / 1000;
          const mp4 = /\.mp4$/i.test(f.name);
          const start = p.start ?? mt;
          return { file: f.name, stream: p.stream, start, duration: Math.max(0, mt - start), size: f.size,
                   status: mp4 ? 'ready' : (now - mt < 90 ? 'recording' : 'flv') };
        });
      source = 'fallback';
    }
    RAW = recs;
    await fetchStat();
    build();
    if (!state.month) {
      const d = ALL[0]?.startD || new Date();
      state.month = new Date(d.getFullYear(), d.getMonth(), 1);
    }
    $('#updated').textContent = `Updated ${fmtTime(new Date())}`;
    render();
    if (!loadedOnce) { loadedOnce = true; openFromHash(); }
    else if (currentFile) refreshPlayerMeta();
  } catch (e) {
    $('#groups').innerHTML = `<div class="empty"><b>Couldn't load recordings</b>${esc(e.message)}<br>Check that <code>/recordings/index.json</code> or <code>/api/files/</code> is reachable.</div>`;
  } finally {
    btn.classList.remove('spin'); btn.disabled = false;
  }
}

function filtered() {
  const q = state.q.trim().toLowerCase();
  let from = null;
  if (!state.day && state.range !== 'all') {
    if (state.range === 'today') { from = new Date(); from.setHours(0, 0, 0, 0); }
    else from = new Date(Date.now() - (+state.range) * 864e5);
  }
  const out = ALL.filter(r =>
    (!state.stream || r.stream === state.stream) &&
    (!state.day || r.day === state.day) &&
    (!from || r.startD >= from) &&
    (!q || r.stream.toLowerCase().includes(q) || r.file.toLowerCase().includes(q) ||
           r.day.includes(q) || fmtDateLong(r.startD).toLowerCase().includes(q)));
  return state.sort === 'asc' ? out.sort((a, b) => a.start - b.start) : out.sort((a, b) => b.start - a.start);
}

/* ===== render ===== */
function render() {
  visible = filtered();
  visible.forEach((r, i) => r._i = i);
  renderStats(); renderLive(); renderCalendar(); renderStreams(); renderChip(); renderList();
}

function renderStats() {
  const done = visible.filter(r => r.status !== 'recording');
  const total = visible.reduce((s, r) => s + r.dur, 0);
  const size = visible.reduce((s, r) => s + (r.size || 0), 0);
  const latest = ALL[0];
  const longest = done.reduce((m, r) => r.dur > (m?.dur || 0) ? r : m, null);
  const scope = state.day ? fmtDateShort(fromKey(state.day)) : state.range === 'all' ? 'all time' :
                state.range === 'today' ? 'today' : `last ${state.range} days`;
  $('#stats').innerHTML = `
    <div class="stat"><div class="k">Recordings</div><div class="v">${visible.length}</div><div class="s">${esc(scope)}${state.stream ? ' · ' + esc(state.stream) : ''}</div></div>
    <div class="stat"><div class="k">Total footage</div><div class="v">${fmtDur(total)}</div><div class="s">${longest ? 'Longest ' + fmtDur(longest.dur) : '&nbsp;'}</div></div>
    <div class="stat"><div class="k">Storage</div><div class="v">${fmtSize(size)}</div><div class="s">${visible.length ? 'avg ' + fmtSize(size / visible.length) : '&nbsp;'}</div></div>
    <div class="stat"><div class="k">Latest</div><div class="v">${latest ? (latest.status === 'recording' ? 'Live now' : ago(latest.endD)) : '—'}</div><div class="s">${latest ? esc(latest.stream) + ' · ' + fmtDateShort(latest.startD) : '&nbsp;'}</div></div>`;
}

function renderLive() {
  const live = ALL.filter(r => r.status === 'recording');
  $('#livePill').classList.toggle('on', live.length > 0);
  $('#liveText').textContent = live.length ? `LIVE · ${live.map(r => r.stream).join(', ')}` : 'LIVE';
}

function renderCalendar() {
  const m = state.month;
  const counts = new Map(), liveDays = new Set();
  for (const r of ALL) {
    if (state.stream && r.stream !== state.stream) continue;
    counts.set(r.day, (counts.get(r.day) || 0) + 1);
    if (r.status === 'recording') liveDays.add(r.day);
  }
  const max = Math.max(1, ...counts.values());
  const first = new Date(m.getFullYear(), m.getMonth(), 1);
  const offset = (first.getDay() + 6) % 7; // Monday first
  const days = new Date(m.getFullYear(), m.getMonth() + 1, 0).getDate();
  const today = dayKey(new Date());
  let html = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'].map(d => `<span class="wd">${d}</span>`).join('');
  html += '<span></span>'.repeat(offset);
  let monthCount = 0;
  for (let d = 1; d <= days; d++) {
    const key = `${m.getFullYear()}-${pad(m.getMonth() + 1)}-${pad(d)}`;
    const c = counts.get(key) || 0; monthCount += c;
    const lvl = c ? Math.min(3, Math.ceil(c / max * 3)) : 0;
    const cls = ['cd', lvl ? 'l' + lvl : '', key === today ? 'today' : '', key === state.day ? 'sel' : '', liveDays.has(key) ? 'has-live' : ''].join(' ');
    html += `<button class="${cls}" data-day="${key}" ${c ? '' : 'disabled'} title="${c ? c + ' recording' + (c > 1 ? 's' : '') : 'No recordings'}">${d}</button>`;
  }
  $('#calGrid').innerHTML = html;
  $('#calTitle').textContent = m.toLocaleDateString([], { month: 'long', year: 'numeric' });
  $('#calInfo').textContent = `${monthCount} this month`;
}

function renderStreams() {
  const counts = new Map(), live = new Set();
  for (const r of ALL) { counts.set(r.stream, (counts.get(r.stream) || 0) + 1); if (r.status === 'recording') live.add(r.stream); }
  const names = [...counts.keys()].sort();
  $('#mStreams').innerHTML =
    `<button class="${state.stream ? '' : 'on'}" data-stream="">All <span class="c">${ALL.length}</span></button>` +
    names.map(n => `<button class="${state.stream === n ? 'on' : ''}" data-stream="${esc(n)}"><span class="sw" style="background:${streamColor(n)}"></span>${esc(n)}${live.has(n) ? '<span class="lv"></span>' : ''}<span class="c">${counts.get(n)}</span></button>`).join('');
  $('#streams').innerHTML =
    `<button class="stream-btn ${state.stream ? '' : 'on'}" data-stream=""><span class="sw" style="background:var(--muted)"></span><span class="n">All streams</span><span class="c">${ALL.length}</span></button>` +
    names.map(n => `<button class="stream-btn ${state.stream === n ? 'on' : ''}" data-stream="${esc(n)}">
      <span class="sw" style="background:${streamColor(n)}"></span><span class="n">${esc(n)}</span>
      ${live.has(n) ? '<span class="lv" title="Live"></span>' : ''}<span class="c">${counts.get(n)}</span></button>`).join('');
}

function renderChip() {
  $('#dayChip').innerHTML = state.day
    ? `<span class="chip">${esc(fmtDateShort(fromKey(state.day)))}<button id="clearDay" aria-label="Clear date">${ICON.close}</button></span>` : '';
  $('#notice').innerHTML = source === 'fallback'
    ? `<div class="notice">Showing a basic file listing. Set up <b>recordings.py</b> (cron) for thumbnails, exact durations and MP4 conversion.</div>` : '';
}

function timeline(day, recs) {
  const d0 = fromKey(day).getTime() / 1000, span = 86400;
  const segs = recs.map(r => {
    const s = Math.max(r.start, d0), e = Math.min(r.start + Math.max(r.dur, 60), d0 + span);
    if (e <= s) return '';
    const left = (s - d0) / span * 100, w = Math.max((e - s) / span * 100, .3);
    const bg = r.status === 'ready' ? `background:${streamColor(r.stream)};` : '';
    return `<button class="tl-seg ${r.status}" style="left:${left}%;width:${w}%;${bg}" data-i="${r._i}"
      title="${esc(r.stream)} · ${fmtTime(r.startD)} – ${r.status === 'recording' ? 'now' : fmtTime(r.endD)} · ${fmtDur(r.dur)}"></button>`;
  }).join('');
  let now = '';
  if (day === dayKey(new Date())) {
    const n = new Date(), p = (n.getHours() * 3600 + n.getMinutes() * 60) / span * 100;
    now = `<span class="now-line" style="left:${p}%" title="Now"></span>`;
  }
  const ticks = [0, 3, 6, 9, 12, 15, 18, 21].map(h =>
    `<span class="${h % 6 ? 'minor' : ''}" style="left:${h / 24 * 100}%">${pad(h)}:00</span>`).join('');
  return `<div class="timeline"><div class="track">${segs}${now}</div><div class="ticks">${ticks}</div></div>`;
}

function card(r) {
  const thumb = r.thumb ? `<img loading="lazy" src="${fileUrl(r.thumb)}" alt="" onerror="this.remove()">` : '';
  const badge = r.status === 'recording' ? '<span class="badge live">● LIVE</span>'
              : r.status === 'processing' ? '<span class="badge warn">Processing</span>'
              : r.status === 'flv' ? '<span class="badge warn">FLV</span>' : '';
  const res = resLabel(r);
  return `<button class="card" data-i="${r._i}">
    <div class="thumb"><div class="ph">${ICON.film}</div>${thumb}${badge}
      <span class="dur">${fmtClock(r.dur)}</span><span class="play"><i>${ICON.play}</i></span></div>
    <div class="body">
      <div class="title"><span style="display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:7px;vertical-align:1px;background:${streamColor(r.stream)}"></span>${esc(r.stream)}</div>
      <div class="when">${fmtTime(r.startD)} – ${r.status === 'recording' ? 'now' : fmtTime(r.endD)} · ${fmtDur(r.dur)}</div>
      <div class="tags">${res ? `<span>${res}</span>` : ''}${r.fps ? `<span>${Math.round(r.fps)} fps</span>` : ''}<span>${fmtSize(r.size)}</span></div>
    </div></button>`;
}

function renderList() {
  const el = $('#groups');
  if (!visible.length) {
    el.innerHTML = ALL.length
      ? `<div class="empty"><b>No recordings match</b>Try another date, stream or search term.</div>`
      : `<div class="empty"><b>No recordings yet</b>Recordings appear here after a stream ends.</div>`;
    return;
  }
  const groups = new Map();
  for (const r of visible) { if (!groups.has(r.day)) groups.set(r.day, []); groups.get(r.day).push(r); }
  let html = '';
  for (const [day, recs] of groups) {
    const d = fromKey(day), total = recs.reduce((s, r) => s + r.dur, 0);
    const size = recs.reduce((s, r) => s + (r.size || 0), 0);
    html += `<section class="day">
      <div class="day-head"><div><h2>${esc(relDay(d))}</h2><div class="sub">${esc(fmtDateLong(d))}</div></div>
        <div class="day-sum">${recs.length} recording${recs.length > 1 ? 's' : ''} · ${fmtDur(total)} · ${fmtSize(size)}</div></div>
      ${timeline(day, recs)}
      <div class="grid">${recs.map(card).join('')}</div></section>`;
  }
  el.innerHTML = html;
}

/* ===== player ===== */
const modal = $('#modal'), video = $('#video');

let hls = null;
function stopLive() {
  if (hls) { hls.destroy(); hls = null; }
  if (video.dataset.live) { video.pause(); video.removeAttribute('src'); video.load(); delete video.dataset.live; delete video.dataset.file; }
}
function loadScript(src) {
  return new Promise((res, rej) => { const el = document.createElement('script'); el.src = src; el.onload = res; el.onerror = () => { el.remove(); rej(); }; document.head.appendChild(el); });
}
function showNope(html) {
  video.hidden = true; $('#nope').hidden = false; $('#nope').innerHTML = html;
}
async function playLive(r) {
  if (video.dataset.file === r.file && video.dataset.live) return;
  stopLive();
  video.dataset.file = r.file; video.dataset.live = '1';
  const url = CFG.hls + encodeURIComponent(r.stream) + '.m3u8';
  const liveErr = `<b>Live preview unavailable</b>Couldn't load the live stream. Make sure HLS is turned on in nginx.conf and the stream uses H.264/AAC.`;
  try {
    if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = url; // Safari / iOS play HLS natively
    } else {
      for (const src of CFG.hlsJs) { if (window.Hls) break; await loadScript(src).catch(() => {}); }
      if (!window.Hls) throw new Error('hls.js not available');
      if (!Hls.isSupported()) throw new Error('unsupported');
      hls = new Hls({ liveSyncDurationCount: 3, lowLatencyMode: false });
      hls.on(Hls.Events.ERROR, (_, d) => {
        if (!d.fatal) return;
        if (d.type === Hls.ErrorTypes.NETWORK_ERROR) setTimeout(() => hls && hls.startLoad(), 3000);
        else if (d.type === Hls.ErrorTypes.MEDIA_ERROR) hls.recoverMediaError();
        else { stopLive(); showNope(liveErr); }
      });
      hls.loadSource(url); hls.attachMedia(video);
    }
    video.play().catch(() => {});
  } catch { stopLive(); showNope(liveErr); }
}
const hashFor = r => r.status === 'recording' ? '#live=' + encodeURIComponent(r.stream) : '#play=' + encodeURIComponent(r.file);

function openPlayer(i) {
  const r = visible[i]; if (!r) return;
  currentFile = r.file;
  if (r.status === 'recording') {
    video.hidden = false; $('#nope').hidden = true;
    playLive(r);
  } else if (r.playable) {
    stopLive();
    video.hidden = false; $('#nope').hidden = true;
    if (video.dataset.file !== r.file) { video.src = fileUrl(r.file); video.dataset.file = r.file; }
    video.playbackRate = speed;
    video.play().catch(() => {});
  } else {
    stopLive();
    video.pause(); video.removeAttribute('src'); video.load(); delete video.dataset.file;
    showNope(r.status === 'processing'
      ? `<b>Processing</b>This stream just ended. It will be playable here in a minute or two.`
      : `<b>Not playable in the browser</b>This recording is still in FLV format. You can download it and play it in VLC, or wait for the converter to process it.`);
  }
  $('#speedSec').hidden = !r.playable || r.status === 'recording';
  $('#pDownload').href = fileUrl(r.file);
  $('#pDownload').setAttribute('download', r.file);
  $('#pDownload').style.display = r.status === 'recording' || r.status === 'processing' ? 'none' : '';
  refreshPlayerMeta();
  if (!modal.classList.contains('open')) {
    modal.classList.add('open'); modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  const hash = hashFor(r);
  if (history.state?.player) history.replaceState({ player: 1 }, '', hash);
  else history.pushState({ player: 1 }, '', hash);
}

function refreshPlayerMeta() {
  const i = visible.findIndex(r => r.file === currentFile);
  const r = ALL.find(x => x.file === currentFile) || visible[i];
  if (!r) return;
  $('#pTitle').textContent = r.stream;
  $('#pSub').innerHTML = r.status === 'recording'
    ? `<span style="color:var(--live);font-weight:600">● Live</span> · started ${fmtTime(r.startD)}`
    : esc(`${relDay(fromKey(r.day))} · ${fmtTime(r.startD)} – ${fmtTime(r.endD)}`);
  const rows = [
    ['Date', fmtDateLong(r.startD)],
    ['Started', fmtTimeS(r.startD)],
    ['Ended', r.status === 'recording' ? 'Still live' : fmtTimeS(r.endD)],
    [r.status === 'recording' ? 'Live for' : 'Duration', r.dur ? `${fmtDur(r.dur)} (${fmtClock(r.dur)})` : '—'],
    r.width ? ['Resolution', `${r.width}×${r.height}${resLabel(r) ? ' · ' + resLabel(r) : ''}`] : null,
    r.fps ? ['Frame rate', `${r.fps} fps`] : null,
    r.vcodec || r.acodec ? ['Codecs', [r.vcodec, r.acodec].filter(Boolean).join(' / ').toUpperCase()] : null,
    r.bitrate ? ['Bitrate', `${(r.bitrate / 1e6).toFixed(2)} Mbps`] : null,
    ['Size', fmtSize(r.size)],
    ['File', r.file],
  ].filter(Boolean);
  $('#pMeta').innerHTML = rows.map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('');
  $('#pPrev').disabled = i <= 0;
  $('#pNext').disabled = i < 0 || i >= visible.length - 1;
}

function closePlayer(fromPop) {
  if (!fromPop && history.state?.player) { history.back(); return; } // popstate finishes the close
  modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
  video.pause();
  stopLive();
  if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
  currentFile = null;
  if (location.hash) history.replaceState(null, '', location.pathname + location.search);
}
window.addEventListener('popstate', () => {
  if (modal.classList.contains('open') && !history.state?.player) closePlayer(true);
});

function step(d) {
  const i = visible.findIndex(r => r.file === currentFile);
  if (i >= 0 && visible[i + d]) openPlayer(i + d);
}

function openFromHash() {
  const m = location.hash.match(/^#(play|live)=(.+)$/);
  if (!m) return;
  const v = decodeURIComponent(m[2]);
  const i = m[1] === 'live'
    ? visible.findIndex(r => r.status === 'recording' && r.stream === v)
    : visible.findIndex(r => r.file === v);
  if (i >= 0) openPlayer(i);
  else toast(m[1] === 'live' ? `${v} is not live right now` : 'That recording is no longer available');
}

video.addEventListener('loadedmetadata', () => {
  const r = ALL.find(x => x.file === video.dataset.file);
  if (r && !r.dur && isFinite(video.duration)) {
    r.dur = video.duration; r.endD = new Date((r.start + r.dur) * 1000);
    refreshPlayerMeta();
  }
});
video.addEventListener('ended', () => { if (!$('#pNext').disabled) toast('Press N for the next recording'); });

$('#speeds').innerHTML = [0.5, 1, 1.25, 1.5, 2, 3].map(s => `<button data-s="${s}" class="${s === 1 ? 'on' : ''}">${s}×</button>`).join('');
$('#speeds').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  speed = +b.dataset.s; video.playbackRate = speed;
  [...$('#speeds').children].forEach(x => x.classList.toggle('on', x === b));
});

/* ===== events ===== */
function toast(msg) {
  const t = $('#toast'); t.textContent = msg; t.classList.add('on');
  clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove('on'), 2200);
}

$('#groups').addEventListener('click', e => {
  const el = e.target.closest('[data-i]'); if (el) openPlayer(+el.dataset.i);
});
$('#calGrid').addEventListener('click', e => {
  const b = e.target.closest('[data-day]'); if (!b || b.disabled) return;
  state.day = state.day === b.dataset.day ? null : b.dataset.day;
  if (isMobile()) setCal(false);
  render(); window.scrollTo({ top: 0, behavior: 'smooth' });
});
$('#calPrev').onclick = () => { state.month = new Date(state.month.getFullYear(), state.month.getMonth() - 1, 1); renderCalendar(); };
$('#calNext').onclick = () => { state.month = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 1); renderCalendar(); };
$('#calToday').onclick = () => { const t = new Date(); state.month = new Date(t.getFullYear(), t.getMonth(), 1); renderCalendar(); };
['#streams', '#mStreams'].forEach(id => $(id).addEventListener('click', e => {
  const b = e.target.closest('[data-stream]'); if (!b) return;
  state.stream = b.dataset.stream; render();
}));
const isMobile = () => matchMedia('(max-width:640px)').matches;
function setCal(open) {
  document.body.classList.toggle('cal-open', open);
  $('#calToggle').setAttribute('aria-expanded', open);
}
$('#calToggle').onclick = () => setCal(!document.body.classList.contains('cal-open'));
$('#dayChip').addEventListener('click', e => { if (e.target.closest('#clearDay')) { state.day = null; render(); } });
function segCtl(id, key) {
  $(id).addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    state[key] = b.dataset.v;
    if (key === 'range') state.day = null;
    [...$(id).children].forEach(x => x.classList.toggle('on', x === b));
    render();
  });
}
segCtl('#range', 'range'); segCtl('#sort', 'sort');
let qT; $('#q').addEventListener('input', e => { clearTimeout(qT); qT = setTimeout(() => { state.q = e.target.value; render(); }, 120); });
$('#refresh').onclick = load;

$('#pClose').onclick = () => closePlayer();
$('#pPrev').onclick = () => step(-1);
$('#pNext').onclick = () => step(1);
modal.addEventListener('click', e => { if (e.target === modal) closePlayer(); });
// swipe down on the video area to close (mobile)
(() => { let y0 = null; const st = $('.stage');
  st.addEventListener('touchstart', e => { y0 = e.touches.length === 1 ? e.touches[0].clientY : null; }, { passive: true });
  st.addEventListener('touchend', e => { if (y0 !== null && e.changedTouches[0].clientY - y0 > 110 && !document.fullscreenElement) closePlayer(); y0 = null; }, { passive: true });
})();
$('#pCopy').onclick = async () => {
  const r = ALL.find(x => x.file === currentFile); if (!r) return;
  const url = location.origin + location.pathname + hashFor(r);
  try { await navigator.clipboard.writeText(url); toast('Link copied'); }
  catch { prompt('Copy this link:', url); }
};

document.addEventListener('keydown', e => {
  const typing = /INPUT|TEXTAREA/.test(document.activeElement?.tagName);
  if (!modal.classList.contains('open')) {
    if (e.key === '/' && !typing) { e.preventDefault(); $('#q').focus(); }
    return;
  }
  if (typing) return;
  const k = e.key.toLowerCase();
  if (k === 'escape') closePlayer();
  else if (k === 'n' || k === ']') step(1);
  else if (k === 'p' || k === '[') step(-1);
  else if (k === 'f' && !video.hidden) { document.fullscreenElement ? document.exitFullscreen() : video.requestFullscreen?.(); }
  else if (document.activeElement !== video && !video.hidden) {
    if (k === ' ') { e.preventDefault(); video.paused ? video.play() : video.pause(); }
    else if (k === 'arrowright') { video.currentTime += 10; }
    else if (k === 'arrowleft') { video.currentTime -= 10; }
  }
});

$('#livePill').onclick = () => {
  let i = visible.findIndex(r => r.status === 'recording');
  if (i < 0) { state.day = null; state.stream = ''; state.range = 'all'; state.q = ''; $('#q').value = '';
    [...$('#range').children].forEach(x => x.classList.toggle('on', x.dataset.v === 'all'));
    render(); i = visible.findIndex(r => r.status === 'recording'); }
  if (i >= 0) openPlayer(i);
};

load();
setInterval(() => { if (!document.hidden) load(); }, CFG.refreshMs);
// real-time live status
setInterval(async () => {
  if (document.hidden || !loadedOnce) return;
  const before = JSON.stringify(LIVE && [...LIVE.keys()].sort());
  await fetchStat();
  build();
  if (before !== JSON.stringify(LIVE && [...LIVE.keys()].sort())) render();
  else { renderLive(); }
  if (currentFile) refreshPlayerMeta();
}, CFG.statMs);
// tick the "live for" counter in the player
setInterval(() => {
  const r = currentFile && ALL.find(x => x.file === currentFile);
  if (r && r.status === 'recording') { r.dur = Date.now() / 1000 - r.start; refreshPlayerMeta(); }
}, 1000);
</script>
</body>
</html>
