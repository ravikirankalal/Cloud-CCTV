[Unit]
Description=Login check for nginx: Firebase Google sign-in -> session cookie (auth_gate.js)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/rtmp-web
Environment=AUTH_DIR=/home/ubuntu/auth
ExecStart=/usr/bin/node /home/ubuntu/rtmp-web/auth_gate.js
Restart=always
RestartSec=5
MemoryMax=80M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/auth

[Install]
WantedBy=multi-user.target
